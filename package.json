{
  "name": "dev-tools-vscode",
  "displayName": "Dev Tools Toolbox",
  "description": "%extension.description%",
  "version": "1.0.0",
  "publisher": "dimanrus",
  "license": "MIT",
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "Other",
    "Formatters",
    "Testing"
  ],
  "keywords": [
    "devtools",
    "developer tools",
    "regex",
    "json",
    "yaml",
    "jwt",
    "base64",
    "uuid",
    "ulid",
    "hash",
    "cron",
    "converter",
    "formatter",
    "generator",
    "qr code",
    "color",
    "icons",
    "lorem ipsum"
  ],
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#161b22",
    "theme": "dark"
  },
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "commands": [
      {
        "command": "devTools.open",
        "title": "%command.open.title%",
        "category": "%command.category%",
        "icon": "$(open-preview)"
      },
      {
        "command": "devTools.openTool",
        "title": "%command.openTool.title%",
        "category": "%command.category%"
      }
    ],
    "keybindings": [
      {
        "command": "devTools.open",
        "key": "ctrl+alt+d",
        "mac": "cmd+alt+d"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "devTools.openTool",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "devTools.open",
          "when": "view == devTools.launcher",
          "group": "navigation"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "devTools.container",
          "title": "%viewsContainer.title%",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "devTools.container": [
        {
          "id": "devTools.launcher",
          "name": "%view.launcher.name%"
        }
      ]
    },
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "devTools.language": {
          "type": "string",
          "enum": [
            "auto",
            "en",
            "ru"
          ],
          "enumDescriptions": [
            "%config.language.auto%",
            "%config.language.en%",
            "%config.language.ru%"
          ],
          "default": "auto",
          "markdownDescription": "%config.language.description%"
        },
        "devTools.startupTool": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.startupTool.description%"
        },
        "devTools.showStatusBar": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.showStatusBar.description%"
        }
      }
    }
  },
  "scripts": {
    "compile": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON build.mts",
    "build": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON build.mts --production",
    "watch": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON build.mts --watch",
    "catalog": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-catalog.mts",
    "preview": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/preview.mts",
    "typecheck": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-catalog.mts && tsc --noEmit",
    "vsix": "npm run build && vsce package --no-dependencies --allow-missing-repository -o dev-tools-vscode-1.0.0.vsix",
    "package": "npm run vsix",
    "vscode:prepublish": "npm run build"
  },
  "dependencies": {
    "diff": "^9.0.0",
    "js-yaml": "^5.5.0",
    "jsonpath-plus": "^11.3.0",
    "marked": "^18.1.3",
    "qrcode-generator": "^2.0.4",
    "semver": "^7.8.6"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.0.0",
    "@types/semver": "^7.7.0",
    "@types/vscode": "1.105.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dimanrus/dev-tools-vscode"
  }
}
